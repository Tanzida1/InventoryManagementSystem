@model IMS.Web.UI.Controllers.RolePermissionController.RolePermissionViewModel

@{
    ViewData["Title"] = "Assign Permissions";
    Layout = "_PrivateLayout";
}

<style>
    .assign-permissions-container {
        max-width: 750px;
        margin: 40px auto;
        background: #ffffff;
        padding: 30px 40px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .assign-permissions-container h2 {
            margin-bottom: 5px;
            font-weight: 700;
            color: #2c3e50;
            text-align: center;
        }

        .assign-permissions-container h5 {
            text-align: center;
            font-size: 16px;
            color: #7f8c8d;
            margin-bottom: 25px;
            border-bottom: 2px solid #f1f2f6;
            padding-bottom: 15px;
        }

    .card {
        background: #fdfefe;
        border: 1px solid #eaeded;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
        max-height: 400px;
        overflow-y: auto;
    }

    .form-check {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
        padding: 8px 10px;
        border-radius: 6px;
        transition: background-color 0.15s ease;
    }

        .form-check:hover {
            background-color: #f4f6f7;
        }

        .form-check:last-child {
            margin-bottom: 0;
        }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #3498db;
    }

    .form-check-label {
        font-weight: 500;
        color: #34495e;
        cursor: pointer;
        margin-bottom: 0;
        font-size: 14px;
    }

    .text-danger {
        color: #e74c3c;
        font-size: 13px;
        margin-bottom: 15px;
        display: block;
    }

    .no-permissions {
        text-align: center;
        color: #7f8c8d;
        font-style: italic;
        padding: 20px;
    }

    .form-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .btn {
        padding: 10px 20px;
        font-size: 15px;
        font-weight: 600;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.2s ease;
    }

    .btn-primary {
        background-color: #3498db;
        color: white;
    }

        .btn-primary:hover {
            background-color: #2980b9;
        }

    .btn-secondary {
        background-color: #95a5a6;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #7f8c8d;
        }
</style>

<div class="assign-permissions-container">
    <h2>Assign Permissions</h2>

    <h5>Role: @Model.RoleName</h5>

    <form asp-action="Assign" method="post">

        <input type="hidden" asp-for="RoleId" />

        <div asp-validation-summary="All" class="text-danger"></div>

        @if (Model.Permissions.Any())
        {
            <div class="card">

                @foreach (var permission in Model.Permissions
                   .Where(x => x.IsActive))
                {
                    <div class="form-check">

                        <input type="checkbox"
                               class="form-check-input"
                               name="SelectedPermissionIds"
                               value="@permission.PermissionId"
                               id="permission_@permission.PermissionId"
                               checked="@(Model.SelectedPermissionIds.Contains(permission.PermissionId) ? "checked" : null)" />

                        <label class="form-check-label"
                               for="permission_@permission.PermissionId">
                            @permission.DisplayText
                            <span style="color: #95a5a6; font-size: 13px;">(@permission.PermissionName)</span>
                        </label>

                    </div>
                }

            </div>
        }
        else
        {
            <p class="no-permissions">No active permissions available.</p>
        }

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Save Permissions
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back
            </a>
        </div>

    </form>
</div>